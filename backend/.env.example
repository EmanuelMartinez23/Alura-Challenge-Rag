# Django
SECRET_KEY=cambiar
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=rag_mantenimientos

# Ollama (corriendo localmente)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_FALLBACK_MODEL=gemma3:1b
EXTRACTION_LLM_MODEL=gemma3:4b

# Proveedor de embeddings: ollama | huggingface | openai
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=bge-m3:latest
EMBEDDINGS_DIMENSION=1024

# Proveedor de LLM: ollama | gemini | openai
LLM_PROVIDER=ollama

# Si se desea usar un LLM de la nube, agregar API keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Parámetros de RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=3
